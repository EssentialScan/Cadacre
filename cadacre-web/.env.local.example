NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Stripe — single Cadacre subscription (optional; the "Subscribe" button
# shows as "Payments not yet configured" until these are set). Create a
# *recurring* Price + Payment Link in the Stripe dashboard, with "After
# payment" redirect set to https://<your-domain>/api/stripe/verify. Also
# register a webhook endpoint (https://<your-domain>/api/stripe/webhook) in
# the Stripe dashboard, listening for at least checkout.session.completed,
# customer.subscription.updated, and customer.subscription.deleted — the
# webhook route itself tags the subscription with the Clerk user id at
# checkout time, so no further dashboard config is needed for renewal/
# cancellation attribution. (2026-08-30: this replaced the earlier separate
# one-time $39 Payment Link — see AGENTS.md §2.)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Groq AI summaries. Server-only; never use NEXT_PUBLIC_GROQ_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Council/planning-application monitoring (AGENTS.md §5m). Optional — the
# /council-watch page shows a plain "not configured yet" state until this is
# set. Create a free Neon Postgres project (neon.tech), copy its pooled
# connection string here, then run `npm run db:generate` (already done, see
# src/db/migrations/) and `npm run db:migrate` to create the tables.
DATABASE_URL=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# invoking /api/cron/council-watch on schedule. Any random string; generate
# one with `openssl rand -hex 32` and set the same value in the Vercel
# project's environment variables.
CRON_SECRET=

