NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Stripe (optional — the "Unlock" button shows as "Payments not yet
# configured" until both of these are set). Create a one-time $39 Payment
# Link in your Stripe dashboard; set its "After payment" redirect to
# https://<your-domain>/api/stripe/verify
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=
STRIPE_SECRET_KEY=

# Groq AI summaries. Server-only; never use NEXT_PUBLIC_GROQ_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

